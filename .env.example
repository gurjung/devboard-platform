# Database connection strings (PostgreSQL / Supabase)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# NextAuth / Auth.js configuration
AUTH_SECRET="your-generated-auth-secret-min-32-chars"
AUTH_TRUST_HOST="true"

# Supabase public credentials
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"

# Supabase server-only admin key (required for storage/logo upload)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Application URL (optional in production, used for invite links)
NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"
